# Project Hype — Backend Environment Variables
# Copy to .env and fill in your keys

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (provided automatically on Railway)
# For local dev: replace <your_mac_username> with output of `whoami`, then run:
#   createdb hype
DATABASE_URL=postgresql://<your_mac_username>@localhost:5432/hype

# ── FX Rates (primary) ────────────────────────────────────────────────────────
# Open Exchange Rates — industry standard for production FX applications
# Broader frontier currency coverage than alternatives
# Free tier: 1,000 requests/month — https://openexchangerates.org/signup/free
# Paid tiers from $12/month for more requests + features
OXR_APP_ID=

# ── FX Rates (secondary fallback) ────────────────────────────────────────────
# ExchangeRate-API v6 — used if OXR call fails
# Free tier: 1,500 requests/month — https://www.exchangerate-api.com/
FX_API_KEY=

# ── Sentiment Scoring ─────────────────────────────────────────────────────────
# Anthropic Claude API — used for geopolitically-aware headline sentiment scoring
# Replaces VADER for exotic/frontier currency context understanding
# Get key at: https://console.anthropic.com/
# Model used: claude-haiku-4-5-20251001 (fast and cheap — ~$0.001 per scoring run)
ANTHROPIC_API_KEY=
ALPHA_VANTAGE_KEY=

# ── Email Alerts ──────────────────────────────────────────────────────────────
# SendGrid API key for Catalyst Score email alerts
# https://sendgrid.com — free tier: 100 emails/day
SENDGRID_API_KEY=

# Verified sender address in your SendGrid account
ALERT_FROM_EMAIL=alerts@projecthype.io

# ── App Config ────────────────────────────────────────────────────────────────
# Public frontend URL (used in alert email links)
APP_URL=https://frontend-production-f60f1.up.railway.app

# Environment name. Set to "production" on Railway to enable hardening:
#   - /docs, /redoc, /openapi.json are disabled
#   - ALLOWED_ORIGINS is required (startup fails if unset)
# Anything other than "production" (incl. unset) is treated as development.
APP_ENV=development

# Comma-separated list of allowed frontend origins for CORS.
# REQUIRED when APP_ENV=production (startup fails if unset).
# In production set to your Railway frontend URL:
ALLOWED_ORIGINS=https://your-frontend.up.railway.app

# Database TLS mode for asyncpg. Options: prefer | require | verify-full
# Set to "require" on Railway (managed Postgres enforces SSL).
# "prefer" (default) allows plaintext fallback — fine for local Docker, not prod.
DB_SSL=prefer

# Comma-separated list of proxy IP addresses/CIDRs that are trusted to set
# X-Forwarded-For / X-Real-IP. Used by uvicorn --forwarded-allow-ips.
# Local dev default: 127.0.0.1
# Railway: set to the Railway internal proxy CIDR (or leave as default and let
#          Railway's edge set the real client IP at the socket level).
FORWARDED_ALLOW_IPS=127.0.0.1

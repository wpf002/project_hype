# Direct runtime dependencies — SOURCE FILE, do not edit requirements.txt directly.
#
# Regenerate requirements.txt after any change here:
#   pip install pip-tools
#   pip-compile requirements.in \
#     --output-file requirements.txt \
#     --generate-hashes \
#     --no-header \
#     --annotation-style line
#
# Upgrade a specific package:
#   pip-compile requirements.in --upgrade-package <name> --generate-hashes ...
#
# Then run the test suite and commit both files together.
